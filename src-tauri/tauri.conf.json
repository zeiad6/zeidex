{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeidex Search",
  "version": "0.4.0",
  "identifier": "com.zeidexsoft.zeidex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Zeidex Search",
        "width": 760,
        "height": 520,
        "minWidth": 520,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": false,
        "shadow": true,
        "visible": false,
        "alwaysOnTop": false,
        "focus": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Zeidexsoft",
    "publisher": "Zeidexsoft",
    "homepage": "https://zeidexsoft.com",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Offline search, OCR and document AI",
    "longDescription": "Zeidex Search is a cross-platform launcher and offline document AI: fuzzy app, file and folder search, clipboard history, an inline calculator, translation, and a document studio that turns scans and PDFs into editable Word and Excel files. No account, no telemetry, and no cloud OCR.",
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/com.zeidexsoft.zeidex.metainfo.xml": "appstream/com.zeidexsoft.zeidex.metainfo.xml"
        }
      }
    },
    "targets": [
      "deb",
      "appimage",
      "msi",
      "nsis",
      "dmg"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "Zeidex",
        "languages": [
          "English",
          "Arabic"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "../third_party/models/*": "models/",
      "resources/lib/*": "lib/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "mainBinaryName": "zeidex"
}
