{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../.test-build",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "files": [
    "src/index-status.ts",
    "src/index-status.test.ts",
    "src/page-range.ts",
    "src/page-range.test.ts",
    "src/settings-draft.ts",
    "src/settings-draft.test.ts",
    "src/window-size.ts",
    "src/window-size.test.ts"
  ]
}
