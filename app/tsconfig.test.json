{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../.test-build",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node"
    ]
  },
  "files": [
    "src/batch-view.ts",
    "src/contrast.test.ts",
    "src/batch-view.test.ts",
    "src/documents.ts",
    "src/documents.test.ts",
    "src/index-status.ts",
    "src/index-status.test.ts",
    "src/page-range.ts",
    "src/model-format.ts",
    "src/model-format.test.ts",
    "src/page-range.test.ts",
    "src/settings-draft.ts",
    "src/settings-draft.test.ts",
    "src/theme.ts",
    "src/theme.test.ts",
    "src/window-size.ts",
    "src/window-size.test.ts"
  ]
}
